@model TH15OTDM.Models.TaiSan
<h3>Create</h3>
<div class="container-mt3">
    <div class="row">
        <div class="col col-md-6">
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <select asp-for="MaLoai" asp-items="ViewBag.TenLoai">
                        <option value="">Chon di nha</option>
                    </select>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TenTs" class="control-label">Ten Tai San</label>
                    <input asp-for="TenTs" class="form-control" placeholder="Nhap Ten Tai San" />
                    <span asp-validation-for="TenTs" class="text-danger"></span>
                </div> 
                <div class="form-group mb-3">
                    <label asp-for="NguyenGia" class="control-label">Gia Tai San</label>
                    <input asp-for="NguyenGia" class="form-control" placeholder="Nhap Gia Tai San" />
                    <span asp-validation-for="NguyenGia" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Anh" class="control-label">Anh Tai San</label>
                    <input asp-for="Anh" class="form-control" placeholder="Nhap Anh Tai San" />
                    <span asp-validation-for="Anh" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>