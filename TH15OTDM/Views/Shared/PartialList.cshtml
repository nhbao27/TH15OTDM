@model IEnumerable<TH15OTDM.Models.TaiSan>
@foreach (var i in Model)
{
    <div class="asset-card">
        <a href="#"><img src="~/images/@i.Anh" alt="" /></a>
        <h2>@i.TenTs</h2>
        <div class="asset-foot"><span class="price">@i.NguyenGia</span><button class="btn-buy">Chi tiết</button>
            <a asp-controller="BaiThi" asp-action="Edit" asp-route-mats="@i.MaTs" class="btn-buy">Sửa</a>
        </div>
    </div>
}